{
  "name": "baigong",
  "version": "0.1.0",
  "description": "百工：由主智能体分配和审核的本地多模型协作插件",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "baigong": "./bin/baigong.mjs"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node bin/baigong.mjs ui",
    "mcp": "node bin/baigong.mjs mcp",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "test:ui": "node --test test/ui.browser.mjs",
    "check": "node scripts/check.mjs",
    "package": "node scripts/package.mjs"
  },
  "files": [
    "bin/",
    "src/",
    "scripts/",
    "web/",
    "web/app.bundle.js",
    "skills/",
    "plugin.json",
    "mcp.json",
    "README.md",
    "LICENSE",
    ".agents/plugins/marketplace.json",
    "package-lock.json"
  ],
  "bundleDependencies": ["@modelcontextprotocol/sdk", "zod"],
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.4",
    "@playwright/test": "1.65.0",
    "esbuild": "0.28.2"
  }
}
